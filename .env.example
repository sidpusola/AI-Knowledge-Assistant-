# Copy this file to .env and adjust values as needed.
# .env is gitignored - it's your local/deployment config, never commit it.

# --- LLM provider ---
# Only "ollama" is supported - free, open-weight models, run locally.
LLM_PROVIDER=ollama

OLLAMA_TEMPERATURE=0.3

# Context window per request (prompt + retrieved chunks + history + answer).
# Ollama's own default is 4096; qwen2.5 supports up to 32768. Higher costs
# VRAM because the KV cache scales with it.
OLLAMA_NUM_CTX=8192

# General-purpose model (longer / more complex questions)
OLLAMA_MODEL=qwen2.5:7b

# Fast model (short / simple questions).
# qwen2.5:3b, not qwen3:4b - measured on this machine, qwen3:4b averaged
# 10.78s on short questions vs 2.72s here, because it's a reasoning model
# that generates ~1200 tokens of hidden chain-of-thought before answering.
# Latency tracks tokens generated, not parameter count.
OLLAMA_MODEL_FAST=qwen2.5:3b

# Questions with <= this many words are routed to OLLAMA_MODEL_FAST
ROUTING_WORD_THRESHOLD=12

# Models that support Ollama "thinking" mode. Sending the flag to a model
# that doesn't support it fails with a 400, so keep this list accurate.
REASONING_MODELS=qwen3:4b

# --- Embeddings ---
# bge-small-en-v1.5: same 384 dims as all-MiniLM but 512-token
# sequence length and better score separation. Needs the query prefix below.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_DEVICE=cpu

# --- Vector store / retrieval ---
CHROMA_DB_PATH=./chroma_db
RETRIEVER_K=3

# --- Text splitting ---
# "recursive" (characters), "token", or "recursive_token".
# recursive_token keeps sentence-aware splitting but measures in tokens,
# which is the unit the embedding model actually limits (256 for
# all-MiniLM-L6-v2, truncated silently above that).
SPLITTER_TYPE=recursive_token

# Used when SPLITTER_TYPE=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Used when SPLITTER_TYPE=token or recursive_token
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40

# --- Storage ---
UPLOAD_DIR=uploads

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
