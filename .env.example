# Copy this file to .env and adjust values as needed.
# .env is gitignored - it's your local/deployment config, never commit it.

# --- LLM provider ---
# Only "ollama" is supported - free, open-weight models, run locally.
LLM_PROVIDER=ollama

OLLAMA_TEMPERATURE=0.3

# General-purpose model (longer / more complex questions)
OLLAMA_MODEL=qwen2.5:7b

# Fast model (short / simple questions).
# qwen2.5:3b, not qwen3:4b - measured on this machine, qwen3:4b averaged
# 10.78s on short questions vs 2.72s here, because it's a reasoning model
# that generates ~1200 tokens of hidden chain-of-thought before answering.
# Latency tracks tokens generated, not parameter count.
OLLAMA_MODEL_FAST=qwen2.5:3b

# Questions with <= this many words are routed to OLLAMA_MODEL_FAST
ROUTING_WORD_THRESHOLD=12

# Models that support Ollama "thinking" mode. Sending the flag to a model
# that doesn't support it fails with a 400, so keep this list accurate.
REASONING_MODELS=qwen3:4b

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Vector store / retrieval ---
CHROMA_DB_PATH=./chroma_db
RETRIEVER_K=3

# --- Text splitting ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Storage ---
UPLOAD_DIR=uploads

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
