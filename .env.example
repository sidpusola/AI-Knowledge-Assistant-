# Copy this file to .env and adjust values as needed.
# .env is gitignored - it's your local/deployment config, never commit it.

# --- LLM provider ---
# Only "ollama" is supported - free, open-weight models, run locally.
LLM_PROVIDER=ollama

OLLAMA_TEMPERATURE=0.3

# Context window per request (prompt + retrieved chunks + history + answer).
# Ollama's own default is 4096; qwen2.5 supports up to 32768. Higher costs
# VRAM because the KV cache scales with it.
OLLAMA_NUM_CTX=8192

# General-purpose model (longer / more complex questions)
OLLAMA_MODEL=qwen2.5:7b

# Fast model (short / simple questions).
# qwen2.5:3b, not qwen3:4b - measured on this machine, qwen3:4b averaged
# 10.78s on short questions vs 2.72s here, because it's a reasoning model
# that generates ~1200 tokens of hidden chain-of-thought before answering.
# Latency tracks tokens generated, not parameter count.
OLLAMA_MODEL_FAST=qwen2.5:3b

# Questions with <= this many words are routed to OLLAMA_MODEL_FAST
ROUTING_WORD_THRESHOLD=12

# Models that support Ollama "thinking" mode. Sending the flag to a model
# that doesn't support it fails with a 400, so keep this list accurate.
REASONING_MODELS=qwen3:4b

# --- Embeddings ---
# bge-small-en-v1.5: same 384 dims as all-MiniLM but 512-token
# sequence length and better score separation. Needs the query prefix below.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMBEDDING_DEVICE=cpu

# --- Vector store / retrieval ---
CHROMA_DB_PATH=./chroma_db
RETRIEVER_K=3

# --- Text splitting ---
# "recursive" (characters), "token", or "recursive_token".
# recursive_token keeps sentence-aware splitting but measures in tokens,
# which is the unit the embedding model actually limits (256 for
# all-MiniLM-L6-v2, truncated silently above that).
SPLITTER_TYPE=recursive_token

# Used when SPLITTER_TYPE=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Used when SPLITTER_TYPE=token or recursive_token
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40

# --- Storage ---
UPLOAD_DIR=uploads

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google sign-in (used by auth.py) ---
# From Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# OAUTH_REDIRECT_URI must appear on that client EXACTLY as written here.
# Google compares the whole string, so a trailing slash, or localhost
# where the client says 127.0.0.1, fails with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Where the browser lands after signing in.
FRONTEND_URL=http://localhost:5173

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, a random key is used and everyone is signed out on restart.
SESSION_SECRET=

# Must be true wherever this is served over HTTPS.
COOKIE_SECURE=false

# How long a sign-in lasts, in seconds. Default is 14 days.
SESSION_MAX_AGE=1209600

# --- Users, sessions and history (used by database/) ---
# SQLite by default, in database/app.db. Any SQLAlchemy URL works, so
# moving to Postgres later is a change here rather than in the code.
# DATABASE_URL=sqlite:///C:/path/to/app.db

# Past turns replayed into the prompt. The full history is always kept.
HISTORY_TURNS=10

# --- Ollama transport ---
# 127.0.0.1, not localhost: where localhost resolves to IPv6 ::1 and
# Ollama binds only to IPv4, every call waits out a ~2s connect timeout.
OLLAMA_BASE_URL=http://127.0.0.1:11434
